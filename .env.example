# Database & Cache
DATABASE_URL=postgresql+asyncpg://clipper:clipperpass@postgres:5432/clipper_db
DATABASE_SYNC_URL=postgresql+psycopg2://clipper:clipperpass@postgres:5432/clipper_db
REDIS_URL=redis://redis:6379/0

# Security & Encryption (Fernet 32-byte url-safe base64 key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KEY_ENCRYPTION_SECRET=your_32_byte_base64_fernet_key_here

# JWT Auth
JWT_SECRET=super_secret_jwt_signing_key_change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage & Processing Limits
STORAGE_PATH=./storage
MAX_VIDEO_MINUTES=60
MAX_FILE_SIZE_MB=500
MAX_PARALLEL_JOBS_PER_USER=3
TEMP_FILE_RETENTION_HOURS=24

# AI Model Defaults
WHISPER_MODEL=base

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
